            "vkGetInstanceProcAddr": "RandOverlay_GetInstanceProcAddr",
            "vkGetDeviceProcAddr": "RandOverlay_GetDeviceProcAddr"
        },
        "disable_environment": { "DISABLE_RANDOVERLAY": "1" }
    }
}
